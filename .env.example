# Docker Environment Configuration
# This file contains all environment variables for the containerized deployment

# Frontend (Vite React App)
# Tyhjä arvo käyttää Viten /api-välitystä. TMDB-avainta ei saa nimetä VITE_-alkuiseksi.
VITE_API_URL=
FRONTEND_PORT=5173

# Backend (Node.js Express Server)
NODE_ENV=development
PORT=3000

# TMDB-tilin API-asetuksista: API Read Access Token (pitkä tunnus).
TMDB_READ_ACCESS_TOKEN=

# Port Configuration
BACKEND_EXPOSED_PORT=3000
FRONTEND_EXPOSED_PORT=5173
DB_EXPOSED_PORT=5432

# Database Configuration
# Backend connection variables (used by Node.js app)
DB_USER=postgres
DB_PASSWORD=root
DB_HOST=database
DB_PORT=5432
DB_NAME=mydb

# PostgreSQL Container Environment Variables
# These specific variable names (POSTGRES_*) are required by the official PostgreSQL Docker image
POSTGRES_DB=mydb
POSTGRES_USER=postgres
POSTGRES_PASSWORD=root

# Kirjautuminen toimii oletuksena paikallisessa Docker-osoitteessa.
# Muussa osoitteessa aseta selaimessa näkyvä frontendin alkuperä, esim. https://leffahaku.example
# APP_ORIGIN=http://localhost:5173
# HTTPS-tuotannossa käytä aina Secure-evästettä:
# SESSION_COOKIE_SECURE=true
